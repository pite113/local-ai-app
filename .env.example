# 模型提供方: mock(演示) | ollama(本地) | openai(兼容API, 如DeepSeek)
LLM_PROVIDER=mock

# --- Ollama 本地模型 (需要先安装 Ollama 并拉取模型) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- OpenAI 兼容 API (DeepSeek / OpenAI / 硅基流动 等) ---
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-你的密钥
OPENAI_MODEL=deepseek-chat

# --- 服务设置 ---
DATA_DIR=data
HOST=127.0.0.1
PORT=8000

# --- 成本估算参考价 (每百万 token, USD; 按 DeepSeek V3.2 参考价, 可改) ---
PRICE_IN_PER_M=0.14
PRICE_OUT_PER_M=0.55

# --- 向量化(Embedding): auto=自动选(优先ollama→api→本地fastembed→词法回退) ---
EMBED_PROVIDER=auto
EMBED_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
EMBED_OLLAMA_BASE_URL=http://localhost:11434
EMBED_OLLAMA_MODEL=nomic-embed-text
EMBED_API_BASE_URL=
EMBED_API_KEY=
EMBED_API_MODEL=

# --- 检索参数 ---
RETRIEVE_THRESHOLD=0.38
RETRIEVE_LEXICAL_THRESHOLD=0.05
DEDUP_THRESHOLD=0.60
CHUNK_MIN_SIZE=80

# --- 批量作图: mock=占位图(测试流程) | api=真实生图(需注册生图服务) ---
IMAGE_PROVIDER=mock
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=

# --- 上架平台 ---
PLATFORM=shopify
SHOPIFY_SHOP=你的店铺名(不含.myshopify.com)
SHOPIFY_ACCESS_TOKEN=店铺后台获取的密钥

# --- 工具与日志 ---
TOOL_CONCURRENCY=3
LOG_MAX_MB=2

# --- 访问认证(OTP验证码+邮件) ---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱
SMTP_PASS=SMTP授权码
MAIL_TO=接收验证码的邮箱
# 管理员口令: 登录页点"管理员入口"输入后才会显示"发送验证码"按钮(防他人刷邮件)
ADMIN_KEY=你的管理员口令
# 技术层口令: 登录页点"技术入口"进入技术层(技术功能可见, 成本/评估不可见)
TECH_KEY=你的技术层口令
# 使用层口令: 登录页点"使用入口"进入使用层(仅使用功能)
CLIENT_KEY=你的使用层口令
# 调试模式: true=未配SMTP时响应返回验证码(仅本地开发), 生产必须 false
OTP_DEBUG=false

# --- 访问控制（也可用脚本控制: 开启访问.bat / 关闭访问.bat / 设置体验时长.bat）---
# data/access.flag: on/off 总开关 (默认 on)
# data/trial_minutes.flag: 数字, 访客体验时长(分钟), 0=不限 (默认 0)
# 登录验证: data/auth_enabled.flag = on 要求验证码登录 | off 直接可用 (默认 off)
#   也可用脚本: 开启登录验证.bat / 关闭登录验证.bat
AUTH_ENABLED=off
