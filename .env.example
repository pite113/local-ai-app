# 模型提供方: mock(演示) | ollama(本地) | openai(兼容API, 如DeepSeek)
LLM_PROVIDER=mock

# --- Ollama 本地模型 (需要先安装 Ollama 并拉取模型) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- OpenAI 兼容 API (DeepSeek / OpenAI / 硅基流动 等) ---
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-你的密钥
OPENAI_MODEL=deepseek-chat

# --- 服务设置 ---
DATA_DIR=data
HOST=127.0.0.1
PORT=8000

# --- 成本估算参考价 (每百万 token, USD; 按 DeepSeek V3.2 参考价, 可改) ---
PRICE_IN_PER_M=0.14
PRICE_OUT_PER_M=0.55

# --- 向量化(Embedding): auto=自动选(优先ollama→api→本地fastembed→词法回退) ---
EMBED_PROVIDER=auto
EMBED_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
EMBED_OLLAMA_BASE_URL=http://localhost:11434
EMBED_OLLAMA_MODEL=nomic-embed-text
EMBED_API_BASE_URL=
EMBED_API_KEY=
EMBED_API_MODEL=

# --- 检索参数 ---
RETRIEVE_THRESHOLD=0.38
RETRIEVE_LEXICAL_THRESHOLD=0.05
DEDUP_THRESHOLD=0.60
CHUNK_MIN_SIZE=80

# --- 批量作图: mock=占位图(测试流程) | api=真实生图(需注册生图服务) ---
IMAGE_PROVIDER=mock
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=

# --- 工具与日志 ---
TOOL_CONCURRENCY=3
LOG_MAX_MB=2

# --- 访问认证(OTP验证码+邮件) ---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱
SMTP_PASS=SMTP授权码
MAIL_TO=接收验证码的邮箱
